<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!-- Landis.Core 3.0.1 is published only on the landis-ii-v8 feed, not nuget.org.
         Without this, restore fails (NU1101) on any machine without a warm NuGet cache. -->
    <add key="landis-ii-v8" value="https://www.myget.org/F/landis-ii-v8/api/v3/index.json" />
  </packageSources>
</configuration>
